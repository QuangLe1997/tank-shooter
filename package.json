{
  "name": "steel-siege",
  "private": true,
  "type": "module",
  "description": "Zero-build game (static files, ES modules, Three.js from CDN). npm is a task runner; devDependencies are ONLY for the maintainer refactor tools (tools/refactor) — the game never loads them.",
  "scripts": {
    "test": "node tools/verify.mjs",
    "ts": "node tools/ts.mjs",
    "lan-room": "node tools/lan-room.mjs",
    "coop-test": "node tools/coop-test.mjs",
    "audio-test": "node tools/audio-test.mjs",
    "licenses": "node tools/licenses.mjs",
    "arch": "node tools/archcheck.mjs",
    "serve": "python3 -m http.server 8765",
    "where": "node tools/where.mjs",
    "studio": "node tools/pose-studio.mjs",
    "imports": "node tools/refactor/fix-imports.mjs",
    "move": "node tools/refactor/move.mjs",
    "deep": "node tools/refactor/deepcheck.mjs",
    "modmap": "node tools/refactor/modmap.mjs",
    "mac": "cd desktop && npm install && node build.mjs"
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "eslint-scope": "^7.2.2"
  }
}
